<Window x:Class="JollyNesEmulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jolly NES Emulator" Width="1100" Height="800" MinWidth="800" MinHeight="650" Background="#181818" Foreground="#E0E0E0" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- NES Display -->
        <Border Grid.Row="0" Margin="20" Background="#000000" BorderBrush="#333333" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Image x:Name="NesScreen" Width="256" Height="240" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Viewbox>
        </Border>

        <!-- Controls -->
        <Border Grid.Row="1" Background="#202020" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="LoadRomButton" Content="Load ROM" Click="LoadRomButton_Click"/>
                <Button Grid.Column="1" x:Name="ResetButton" Content="Reset" Click="ResetButton_Click"/>
                <Button Grid.Column="2" x:Name="PauseButton" Content="Pause" Click="PauseButton_Click"/>
                <TextBlock Grid.Column="4" x:Name="RomNameText" VerticalAlignment="Center" Margin="20,0,8,0" Foreground="#AAAAAA" Text="No ROM loaded" />
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#151515" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center" Foreground="#999999" Text="Ready"/>
                <TextBlock Grid.Column="1" x:Name="CpuStatusText" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#999999" Text="CPU: Stopped"/>
                <TextBlock Grid.Column="2" x:Name="FpsText" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#999999" Text="FPS: 0"/>
                <TextBlock Grid.Column="3" x:Name="FrameText" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#999999" Text="Frame: 0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
